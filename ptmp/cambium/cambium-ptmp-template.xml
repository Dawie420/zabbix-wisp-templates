<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.4</version>
    <template_groups>
        <template_group>
            <uuid>d13956addf624645a3d7008634085395</uuid>
            <name>Templates</name>
        </template_group>
    </template_groups>
    <templates>
        <template>
            <uuid>77d07e29be48480f8f7028a5fcc11df4</uuid>
            <template>zDEV - Cambium - Sector</template>
            <name>zDEV - Cambium - Sector</name>
            <description>zDEV Cambium AP Monitoring. Community: snmp-zDEV-wifi.</description>
            <groups>
                <group>
                    <name>Templates</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>8635e44a7dc04cc5a342e698a9d1b18f</uuid>
                    <name>Client names: walk</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>walk[.1.3.6.1.4.1.17713.21.1.2.30.1.18]</snmp_oid>
                    <key>client.names.walk</key>
                    <delay>5m</delay>
                    <history>7d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>eb8c32c0e32c4ac0aed9b3526eb05fb6</uuid>
                    <name>ICMP ping</name>
                    <type>SIMPLE</type>
                    <key>icmpping</key>
                    <history>30d</history>
                    <valuemap>
                        <name>Ping</name>
                    </valuemap>
                    <triggers>
                        <trigger>
                            <uuid>826010786bab4fd8b324e015110ac42c</uuid>
                            <expression>max(/zDEV - Cambium - Sector/icmpping,#3)=0</expression>
                            <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                            <recovery_expression>min(/zDEV - Cambium - Sector/icmpping,#3)=1</recovery_expression>
                            <name>ICMP - Unavailable by ICMP Ping</name>
                            <priority>HIGH</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>d70c0fd4f43745949a791642d450625c</uuid>
                    <name>ICMP ping loss</name>
                    <type>SIMPLE</type>
                    <key>icmppingloss</key>
                    <history>30d</history>
                    <units>%</units>
                </item>
                <item>
                    <uuid>9c140e94783d4b37ad77e60867085d4f</uuid>
                    <name>ICMP ping response time</name>
                    <type>SIMPLE</type>
                    <key>icmppingsec</key>
                    <history>30d</history>
                    <units>s</units>
                </item>
                <item>
                    <uuid>af8d02843a7b43b28688282a2d874851</uuid>
                    <name>Radio: Active Firmware</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.17713.21.1.1.1.0</snmp_oid>
                    <key>radio.active.firmware</key>
                    <delay>1h</delay>
                    <history>90d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>fab1b637de864f7a9fe28de4c1c1b00f</uuid>
                    <name>Radio: Channel Width</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.17713.21.1.2.102.0</snmp_oid>
                    <key>radio.channel.width</key>
                    <delay>1h</delay>
                    <history>30d</history>
                </item>
                <item>
                    <uuid>85263d1ac55548d48d8bfaf37f3107fc</uuid>
                    <name>Radio: Device Name</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.17713.21.1.1.13.0</snmp_oid>
                    <key>radio.device.name</key>
                    <delay>15m</delay>
                    <history>90d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>cfc8e180c5424f1dbaf35430d1a48b7c</uuid>
                    <name>Radio: Frequency</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.17713.21.1.2.1.0</snmp_oid>
                    <key>radio.frequency</key>
                    <delay>1h</delay>
                    <history>30d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>4d0e80903c814a458837fcfab67aa4ba</uuid>
                    <name>Radio: Serial Number</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.17713.21.1.1.30.0</snmp_oid>
                    <key>radio.serial.number</key>
                    <delay>1h</delay>
                    <history>90d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>dba426155bd24142b0dd487efcedc8d4</uuid>
                    <name>Radio: SSID</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.4.1.17713.21.1.1.11.0</snmp_oid>
                    <key>radio.ssid</key>
                    <delay>24h</delay>
                    <history>90d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>a21cf6b4f8544ed59d96dcafeb40f905</uuid>
                    <name>Radio: Uptime</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>1.3.6.1.2.1.1.3.0</snmp_oid>
                    <key>radio.uptime.seconds</key>
                    <delay>5m</delay>
                    <history>90d</history>
                    <value_type>FLOAT</value_type>
                    <trends>0</trends>
                    <units>uptime</units>
                    <preprocessing>
                        <step>
                            <type>MULTIPLIER</type>
                            <parameters>
                                <parameter>0.01</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <triggers>
                        <trigger>
                            <uuid>f473e609dff2461e8665ccb1d287eec1</uuid>
                            <expression>last(/zDEV - Cambium - Sector/radio.uptime.seconds)&lt;10m</expression>
                            <name>Device rebooted</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>
                <item>
                    <uuid>8f02306ef98c461a9861765c70f856ec</uuid>
                    <name>Device description</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.2.1.1.1.0</snmp_oid>
                    <key>system.description</key>
                    <delay>15m</delay>
                    <history>90d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>7ce4c425020f4f3a96fcd357e9c02ab2</uuid>
                    <name>System name</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>.1.3.6.1.2.1.1.5.0</snmp_oid>
                    <key>system.name</key>
                    <delay>15m</delay>
                    <history>90d</history>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>73d4c625a11b4aeab8131c2ca22fa337</uuid>
                    <name>Wireless : AP Population</name>
                    <type>CALCULATED</type>
                    <key>wireless.ap.population</key>
                    <delay>10m</delay>
                    <value_type>FLOAT</value_type>
                    <units>%</units>
                    <params>round((last(//wireless.clients.count) / 70) * 100, 0)</params>
                    <tags>
                        <tag>
                            <tag>ap_load</tag>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>06a3cf48fc524646a189d4677a408b3b</uuid>
                    <name>Wireless: Registered client count</name>
                    <type>DEPENDENT</type>
                    <key>wireless.clients.count</key>
                    <history>30d</history>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var s = value ? value.trim() : ''; if (s === '') return 0; return s.split(/\n+/).filter(function(line){ return line.trim() !== ''; }).length;</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>client.names.walk</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>stationcount</tag>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>4c44f5ee74fd432c9be72c6c0272b0b2</uuid>
                    <name>SNMP - Service</name>
                    <type>INTERNAL</type>
                    <key>zabbix[host,snmp,available]</key>
                    <delay>3m</delay>
                    <valuemap>
                        <name>Service State - SNMP</name>
                    </valuemap>
                    <tags>
                        <tag>
                            <tag>Application</tag>
                            <value>#Status - Availability</value>
                        </tag>
                    </tags>
                    <triggers>
                        <trigger>
                            <uuid>464b0e7a31424fb7876082f62d47801e</uuid>
                            <expression>max(/zDEV - Cambium - Sector/zabbix[host,snmp,available],#4)=0</expression>
                            <name>SNMP - Unavailable by SNMP Polling</name>
                            <priority>HIGH</priority>
                            <description>Last three attempts returned timeout.  Please check device connectivity.

Ensure community public is used</description>
                            <manual_close>YES</manual_close>
                            <dependencies>
                                <dependency>
                                    <name>ICMP - Unavailable by ICMP Ping</name>
                                    <expression>max(/zDEV - Cambium - Sector/icmpping,#3)=0</expression>
                                    <recovery_expression>min(/zDEV - Cambium - Sector/icmpping,#3)=1</recovery_expression>
                                </dependency>
                            </dependencies>
                        </trigger>
                    </triggers>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <uuid>bd6b317325964d49afa6eb70bed06c4f</uuid>
                    <name>Cambium: Client discovery</name>
                    <type>SNMP_AGENT</type>
                    <snmp_oid>discovery[{#CLIENTNAME},.1.3.6.1.4.1.17713.21.1.2.30.1.18,{#CLIENTRSSI},.1.3.6.1.4.1.17713.21.1.2.30.1.4]</snmp_oid>
                    <key>cambium.client.discovery</key>
                    <delay>10m</delay>
                    <lifetime>30d</lifetime>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>7b9c4ab2522a4fc4a45a8e477d48c41d</uuid>
                            <name>Client {#CLIENTNAME}: Signal</name>
                            <type>SNMP_AGENT</type>
                            <snmp_oid>.1.3.6.1.4.1.17713.21.1.2.30.1.4.{#SNMPINDEX}</snmp_oid>
                            <key>cambium.client.signal[{#SNMPINDEX}]</key>
                            <delay>5m</delay>
                            <history>30d</history>
                            <value_type>FLOAT</value_type>
                            <units>dBm</units>
                            <trigger_prototypes>
                                <trigger_prototype>
                                    <uuid>238865c0c8924f928022aabcea92924c</uuid>
                                    <expression>min(/zDEV - Cambium - Sector/cambium.client.signal[{#SNMPINDEX}],30m)&lt;-70</expression>
                                    <recovery_mode>RECOVERY_EXPRESSION</recovery_mode>
                                    <recovery_expression>min(/zDEV - Cambium - Sector/cambium.client.signal[{#SNMPINDEX}],5m)&gt;=-70</recovery_expression>
                                    <name>Client : {#CLIENTNAME} Signal is low (&lt;-70 dBm)</name>
                                    <priority>WARNING</priority>
                                    <manual_close>YES</manual_close>
                                </trigger_prototype>
                            </trigger_prototypes>
                        </item_prototype>
                    </item_prototypes>
                </discovery_rule>
            </discovery_rules>
            <valuemaps>
                <valuemap>
                    <uuid>72d7f2431a04485a96d28e0a113285bf</uuid>
                    <name>Ping</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Down</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Up</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
                <valuemap>
                    <uuid>728a56e8a95849f3835562e4b0af20e8</uuid>
                    <name>Service State - SNMP</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Not Available</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Available</newvalue>
                        </mapping>
                        <mapping>
                            <value>2</value>
                            <newvalue>Unknown</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
    </templates>
</zabbix_export>
