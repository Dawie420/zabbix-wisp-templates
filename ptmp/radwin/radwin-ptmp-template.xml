                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var lld = [];

// 1. Isolate the HSU section between 'HBSMonData:' and ';'
var parts = value.split('HBSMonData:');
if (parts.length &gt; 1) {
    var hsuSection = parts[1].split(';')[0];
    var hsuEntries = hsuSection.split('*');

    for (var i = 0; i &lt; hsuEntries.length; i++) {
        var entry = hsuEntries[i].trim();
        if (!entry) continue;

        var fields = entry.split('|');

        // Extract key fields according to RADWIN format
        var suName = fields[0] ? fields[0].trim() : '';
        var suMac  = fields[11] ? fields[11].trim() : '';
        
        if (suMac) {
            lld.push({
                &quot;{#SU_NAME}&quot;: suName,
                &quot;{#SU_MAC}&quot;: suMac,
                &quot;{#SU_IP}&quot;: fields[1] ? fields[1].trim() : '',
                &quot;{#SU_SITE}&quot;: fields[3] ? fields[3].trim() : ''
            });
        }
    }
}

return JSON.stringify(lld);</parameter>
                            </parameters>
                        </step>
