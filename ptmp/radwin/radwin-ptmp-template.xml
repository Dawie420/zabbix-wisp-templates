                    <name>RADWIN Sector Monitor - Raw Data</name>
                    <type>SCRIPT</type>
                    <key>radwin.monitor.raw</key>
                    <value_type>TEXT</value_type>
                    <params>try {
    var params = JSON.parse(value);
    var baseUrl = 'http://' + params.url;
    
    var req = new HttpRequest();
    
    // Set HTTP Basic Auth
    req.setHttpAuth(1, params.user, params.pass);
    
    // Set headers matching your browser's exact cURL
    req.addHeader('Content-Type: text/plain;charset=UTF-8');
    req.addHeader('Referer: ' + baseUrl + '/mobile/monitor.asp');
    req.addHeader('Origin: ' + baseUrl);
    
    // Send POST request directly to monitorData.asp with cache-busting dummy payload
    var monitorUrl = baseUrl + '/mobile/monitorData.asp';
    var payload = 'dummy=' + Math.floor(Math.random() * 100);
    
    var response = req.post(monitorUrl, payload);

    if (req.getStatus() !== 200) {
        throw 'Fetch failed with HTTP ' + req.getStatus() + ': ' + response;
    }

    return response;

} catch (error) {
    Zabbix.log(3, 'RADWIN Fetch Error: ' + error);
    return JSON.stringify({ error: error.toString() });
}</params>
