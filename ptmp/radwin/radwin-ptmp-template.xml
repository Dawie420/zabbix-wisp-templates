                <item>
                    <uuid>c7264359fafd4aa2b13d2269a93e3a13</uuid>
                    <name>RADWIN Sector Monitor - Raw Data</name>
                    <type>SCRIPT</type>
                    <key>radwin.monitor.raw</key>
                    <value_type>TEXT</value_type>
                    <params>try {
    // 1. Parse host parameter
    var params = JSON.parse(value);
    var host = params.url ? params.url.trim() : '';

    if (!host.startsWith('http://') &amp;&amp; !host.startsWith('https://')) {
        host = 'http://' + host;
    }

    var userAgent = 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0.0.0 Safari/537.36';

    // 2. Authenticate
    var authReq = new HttpRequest();
    authReq.addHeader('Content-Type: application/json');
    authReq.addHeader('Accept: application/json, text/plain, */*');
    authReq.addHeader('User-Agent: ' + userAgent);

    var authPayload = JSON.stringify({
        &quot;username&quot;: &quot;{$RADWIN.USER}&quot;,
        &quot;password&quot;: &quot;{$RADWIN.PASS}&quot;,
        &quot;connection&quot;: &quot;local&quot;
    });

    var authResp = authReq.post(host + '/auth', authPayload);

    if (authReq.getStatus() !== 200) {
        throw 'Auth failed with HTTP ' + authReq.getStatus() + ': ' + authResp;
    }

    // Parse authentication tokens
    var authJson = JSON.parse(authResp);
    if (!authJson.data || !authJson.data.access_token) {
        throw 'Auth response missing access_token';
    }

    var accessToken = authJson.data.access_token;
    var clientId = authJson.data.clientId || '';

    // 3. Extract session cookies
    var headers = authReq.getHeaders();
    var cookiePairs = [];
    for (var k in headers) {
        if (k.toLowerCase() === 'set-cookie') {
            var rawVal = headers[k];
            var cookieList = Array.isArray(rawVal) ? rawVal : typeof rawVal === 'string' ? rawVal.split(/\r?\n|, (?=[a-zA-Z0-9_ -]+=)/) : [];

            for (var i = 0; i &lt; cookieList.length; i++) {
                var c = cookieList[i].trim();
                if (c) {
                    var pair = c.split(';')[0].trim();
                    if (pair &amp;&amp; cookiePairs.indexOf(pair) === -1) {
                        cookiePairs.push(pair);
                    }
                }
            }
        }
    }
    var cookieHeader = cookiePairs.join('; ');

    // 4. Fetch Monitor Data
    var monitorReq = new HttpRequest();
    monitorReq.addHeader('Accept: application/json, text/plain, */*');
    monitorReq.addHeader('User-Agent: ' + userAgent);
    monitorReq.addHeader('Authorization: Bearer ' + accessToken);
    if (clientId) monitorReq.addHeader('clientId: ' + clientId);
    monitorReq.addHeader('Referer: ' + host + '/hbs-dashboard/sector-view/table-view');
    if (cookieHeader) monitorReq.addHeader('Cookie: ' + cookieHeader);

    var timestamp = new Date().getTime();
    var monitorUrl = host + '/api/v1/monitor?ddd=' + timestamp;
    
    var monitorResp = monitorReq.get(monitorUrl);

    if (monitorReq.getStatus() !== 200) {
        throw 'Monitor data fetch failed with HTTP ' + monitorReq.getStatus() + ': ' + monitorResp;
    }

    return monitorResp;

} catch (error) {
    Zabbix.log(3, '[ RADWIN Script ] Error: ' + error);
    return JSON.stringify({&quot;error&quot;: String(error)});
}</params>
